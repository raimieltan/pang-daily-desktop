class_name Ambience
extends Node
## The mountain at night and by day (sounds generated by tools/audio/synth_ambience.py, CC0):
## wind all the time, a cricket chorus that rises as night falls, and now and then a dog barking
## across the valley, placed out in the dark around the listener so it comes from somewhere.

const CRICKETS := preload("res://assets/audio/ambience/crickets_loop.wav")
const WIND := preload("res://assets/audio/ambience/wind_loop.wav")
const BARK := preload("res://assets/audio/ambience/dog_bark_far.wav")

## Where barks are placed from (the camera, normally).
var listener: Node3D

var _crickets := AudioStreamPlayer.new()
var _wind := AudioStreamPlayer.new()
var _bark := AudioStreamPlayer3D.new()
var _next_bark := 8.0
var _rng := RandomNumberGenerator.new()


static func ensure_bus() -> void:
	if AudioServer.get_bus_index("Ambience") >= 0:
		return
	AudioServer.add_bus()
	var i := AudioServer.bus_count - 1
	AudioServer.set_bus_name(i, "Ambience")
	AudioServer.set_bus_send(i, "Master")


func _ready() -> void:
	ensure_bus()
	_rng.randomize()
	for p in [[_crickets, CRICKETS], [_wind, WIND]]:
		var player: AudioStreamPlayer = p[0]
		player.stream = CarAudio._looped(p[1])
		player.bus = "Ambience"
		player.volume_db = -80.0
		add_child(player)
		player.play()
	_wind.play(_rng.randf() * 10.0)
	_bark.stream = BARK
	_bark.bus = "Ambience"
	_bark.unit_size = 40.0
	_bark.max_distance = 600.0
	_bark.attenuation_model = AudioStreamPlayer3D.ATTENUATION_LOGARITHMIC
	_bark.volume_db = -6.0
	add_child(_bark)


func _process(delta: float) -> void:
	var night := MangaArt.night
	_crickets.volume_db = linear_to_db(maxf(night, 0.0001) * 0.55)
	_wind.volume_db = linear_to_db(lerpf(0.42, 0.3, night))
	_next_bark -= delta
	if _next_bark <= 0.0:
		# More dogs at night; by day they mostly sleep.
		_next_bark = _rng.randf_range(15.0, 40.0) if night > 0.5 else _rng.randf_range(45.0, 100.0)
		if is_instance_valid(listener) and listener.is_inside_tree():
			var a := _rng.randf() * TAU
			var r := _rng.randf_range(70.0, 160.0)
			_bark.global_position = listener.global_position + Vector3(cos(a) * r, -_rng.randf_range(10.0, 40.0), sin(a) * r)
			_bark.pitch_scale = _rng.randf_range(0.85, 1.15)
			_bark.play()
